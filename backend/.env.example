PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,http://localhost:5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

MONGO_URI=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Stellar Classic (Horizon) ──
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ── Soroban (Smart Contracts) ──
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_CONTRACT_ID=CCE2HEK4KS3TFJZRZS65FSPYPP7DYCR2O2QJB2AGVHQVGFQ52MDNJ7DP
SOROBAN_NATIVE_TOKEN=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
SOROBAN_MAX_RETRIES=3
SOROBAN_RETRY_DELAY=1000
SOROBAN_RPC_TIMEOUT=30000
SOROBAN_POLL_INTERVAL=2000
SOROBAN_CONFIRM_RETRIES=30
SOROBAN_EVENT_SYNC_INTERVAL=10000
SOROBAN_EVENT_SYNC_START_LEDGER=0

# Optional, not required for the current non-custodial flow
STELLAR_SECRET=
STELLAR_PUBLIC=

# ── Logging ──
BLOCKCHAIN_LOG_LEVEL=info